# Dans tous les environnements, les fichiers suivants sont chargés s'ils existent,
# le dernier ayant la priorité sur le précédent :
#
#  * .env                contient les valeurs par défaut des variables d'environnement
#  * .env.local          fichier non commité avec les surcharges locales
#  * .env.$APP_ENV       valeurs par défaut spécifiques à l'environnement (commité)
#  * .env.$APP_ENV.local surcharges spécifiques à l'environnement (non commité)
#
# Les vraies variables d'environnement ont la priorité sur les fichiers .env.
#
# NE PAS DÉFINIR LES SECRETS DE PRODUCTION DANS CE FICHIER NI DANS AUCUN FICHIER COMMITÉ.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Lancer "composer dump-env prod" pour compiler les fichiers .env pour la production.
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure comment générer les URLs dans des contextes non-HTTP, comme les commandes CLI.
# Voir https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format décrit sur https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT : Vous DEVEZ configurer la version de votre serveur, soit ici soit dans config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

# Serveur SMTP via Brevo (gratuit, 300 emails/jour) — https://brevo.com
MAILER_DSN=smtp://TON_LOGIN_BREVO:TON_MOT_DE_PASSE_SMTP@smtp-relay.brevo.com:587

# Email qui recevra le rapport quotidien des nouvelles offres d'alternance
ALTFINDER_RECIPIENT_EMAIL=ton.email@gmail.com

# Email expéditeur (doit être vérifié dans Brevo)
ALTFINDER_SENDER_EMAIL=noreply@altfinder.fr
###> symfony/brevo-mailer ###
# MAILER_DSN=brevo+api://KEY@default
# MAILER_DSN=brevo+smtp://USERNAME:PASSWORD@default
###< symfony/brevo-mailer ###
